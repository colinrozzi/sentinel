# sentinel.service — one clean sentinel instance (Phase A, Topology B).
#
# DRAFT / template. The lessons from the 2026-07-05 incident are baked in:
#   - hard cgroup memory ceiling so a leak is throttled then OOM-killed and
#     restarted as a UNIT, instead of silently starving inbox on the 964MB box
#     (the debug-logging experiment ballooned to 362MB and took prod down).
#   - warn/error-only logging (debug/trace logging was the balloon's cause).
#
# PROD-SPECIFIC values marked TODO must be filled to mirror inbox.service
# exactly (same theater binary path, same User, same WorkingDirectory
# convention). Ask claude for the current inbox.service as the reference
# before this ships — the ExecStart theater binary MUST be the prod-pinned
# theater (f852aec3 / #132), not a stray build, or the version skew bites.

[Unit]
Description=sentinel — supervises the prod actor tree (inbox-ui, tickets-ui, frontdoor; Phase A)
After=network-online.target
Wants=network-online.target
# Does NOT depend on inbox.service and must never bind the same ports —
# Topology B keeps the two side by side, never supervising the same actor.

[Service]
Type=simple

# TODO(prod): mirror inbox.service. The prod-pinned theater binary spawns the
# sentinel manifest; the manifest's initial_state carries the child map.
#   ExecStart=/TODO/path/to/theater spawn /TODO/path/to/sentinel-actor/manifest.toml
ExecStart=/TODO/theater spawn /TODO/sentinel-actor/manifest.toml
WorkingDirectory=/TODO/sentinel
User=TODO

# --- the memory ceiling (the point of this unit) ---
# MemoryHigh throttles reclaim as we approach; MemoryMax is the hard OOM-kill
# line. Sized for Topology B (sentinel + inbox-ui + tickets-ui + frontdoor,
# ~4 in-theater actors). Re-tune only after measuring; do NOT raise blindly.
MemoryHigh=250M
MemoryMax=350M
# Accounting on so the numbers show up in systemctl status / cgroup stats.
MemoryAccounting=yes

# --- logging discipline ---
# warn/error only. No debug/trace in prod — that is what caused the balloon.
Environment=RUST_LOG=warn
# (If the prod theater takes a --log-level flag instead of RUST_LOG, set it on
#  ExecStart to warn; mirror whatever inbox.service does.)

# --- restart policy ---
# Sentinel restarting reboots the whole in-process child tree, so restart on
# failure but back off. The in-actor crash-loop rate limiter handles per-child
# thrash; this is the outer guard for the sentinel process itself.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
